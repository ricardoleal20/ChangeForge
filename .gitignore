# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock is committed because this project ships an executable.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Ignore the poetry.lock
poetry.lock

# Ignore the .env
.env

# Ignore the .DS_STORE
.DS_STORE

# Ignore the png
.png
.jpeg

# Ignore the dist folder
dist/

# Disposable local demos and operation locks (release.json is committed).
.demo/
.releaseweave/operation.lock
__pycache__/

# Generated documentation site; sources are under docs/webpage/.
/docs/index.html
/docs/configuration.html
/docs/getting-started.html
/docs/commands/
/docs/styles.css
